{
  "manifest_version": 3,
  "name": "Ethan 工单助手",
  "version": "1.0.51",
  "description": "Ethan 工单管理快捷工具：将模版错写及模板主图别名统一统计为模板。",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "downloads",
    "offscreen",
    "webNavigation",
    "downloads.ui",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://ethan.hzzichi.com/*",
    "*://*.1688.com/*",
    "*://*.alibaba.com/*",
    "*://*.alicdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.taobao.com/*",
    "*://*.alibabausercontent.com/*",
    "*://*.aliyuncs.com/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Ethan 工单助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ethan.hzzichi.com/*"
      ],
      "js": [
        "workorder-acceptance-time.js",
        "service-quantity-arithmetic.js",
        "daily-planned-points.js",
        "quick-query-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ethan.hzzichi.com/*"
      ],
      "js": [
        "content.js",
        "customer-followup-refresh.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*",
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*"
      ],
      "js": [
        "product-page-entry.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://1688.com/*",
        "*://*.1688.com/*",
        "*://*.alibaba.com/*",
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.alicdn.com/*",
        "*://*.aliyun.com/*",
        "*://*.aliyuncs.com/*",
        "*://*.alibabacloud.com/*",
        "*://*.alipay.com/*"
      ],
      "js": [
        "popup-closer/rules.js",
        "popup-closer/page_context.js",
        "popup-closer/content.js"
      ],
      "css": [
        "popup-closer/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED",
      "exclude_matches": [
        "*://login.taobao.com/*",
        "*://login.1688.com/*",
        "*://passport.taobao.com/*",
        "*://passport.1688.com/*",
        "*://passport.alibaba.com/*",
        "*://*.1688.com/*login*",
        "*://*.1688.com/*signin*",
        "*://*.1688.com/member/jump.htm*",
        "*://*.1688.com/member/marketSigninJump.htm*",
        "*://*.taobao.com/*login*",
        "*://*.alibaba.com/*login*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "ps-images.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.koukoutu.com/removebgtool/*",
        "https://koukoutu.com/removebgtool/*"
      ],
      "js": [
        "koukoutu/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.koukoutu.com/removebgtool/*",
        "https://koukoutu.com/removebgtool/*"
      ],
      "js": [
        "koukoutu/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "word-library.html",
        "word-library.js",
        "vendor/ocr/words.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ]
}
