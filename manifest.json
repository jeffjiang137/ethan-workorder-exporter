{
  "manifest_version": 3,
  "name": "Ethan 工单助手",
  "version": "1.0.48",
  "description": "Ethan 工单管理快捷工具：将模版错写及模板主图别名统一统计为模板。",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "downloads",
    "offscreen",
    "webNavigation",
    "downloads.ui",
    "notifications"
  ],
  "host_permissions": [
    "https://ethan.hzzichi.com/*",
    "*://*.1688.com/*",
    "*://*.alibaba.com/*",
    "*://*.alicdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.taobao.com/*",
    "*://*.alibabausercontent.com/*",
    "*://*.aliyuncs.com/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "action": {
    "default_title": "Ethan 工单助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ethan.hzzichi.com/*"
      ],
      "js": [
        "workorder-acceptance-time.js",
        "service-quantity-arithmetic.js",
        "daily-planned-points.js",
        "quick-query-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ethan.hzzichi.com/*"
      ],
      "js": [
        "content.js",
        "customer-followup-refresh.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.1688.com/*",
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*"
      ],
      "js": [
        "product-page-entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
